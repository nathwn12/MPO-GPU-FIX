<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AMDGPUFIX</RootNamespace>
    <AssemblyName>MPOGPUFIX</AssemblyName>
    <ApplicationIcon>mpo-icon.ico</ApplicationIcon>
    <StartupObject>AMDGPUFIX.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <Authors>Endless</Authors>
    <Company>Endless</Company>
    <Product>MPOGPUFIX</Product>
    <Description>MPO GPU Fix Tool</Description>
    <Copyright>Copyright © 2026</Copyright>
    <Version>8.0.0</Version>
    <FileVersion>8.0.0.0</FileVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MaterialSkin">
      <HintPath>Resources\MaterialSkin.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\MaterialSkin.zip" />
  </ItemGroup>
</Project>
